{
  "name": "school-tenancy-spike",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "build:web": "pnpm --filter web build",
    "start": "nest start --env-file .env",
    "start:dev": "nest start --watch --env-file .env",
    "start:web": "pnpm --filter web dev",
    "start:worker": "nest start --entryFile worker --path tsconfig.worker.json --env-file .env",
    "start:receiver": "node dev/receiver.ts",
    "dev": "pnpm run \"/^start:(dev|web|worker|receiver)$/\"",
    "format": "prettier --write .",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit && pnpm --filter web typecheck",
    "test": "vitest run",
    "test:web": "pnpm --filter web test",
    "test:e2e": "pnpm build && pnpm --filter web build && pnpm --filter web test:e2e",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "node --env-file=.env db/migrate.ts",
    "db:seed": "node --env-file=.env db/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "pg-boss": "12.38.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
